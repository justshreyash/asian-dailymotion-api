# =============================================================================
# KOREAN DRAMA -> DAILYMOTION PIPELINE ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# DB_MODE: "local" (uses SQLite file via better-sqlite3) or "turso" (LibSQL edge)
DB_MODE=local
DB_PATH=./data/local.db

# Turso Cloud Database (Production Mode - Required when DB_MODE=turso)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# -----------------------------------------------------------------------------
# TMDB API (The Movie Database)
# -----------------------------------------------------------------------------
# Free API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# -----------------------------------------------------------------------------
# Security & Endpoints Protection
# -----------------------------------------------------------------------------
# Secret token to authorize Vercel Cron jobs (/api/cron/process)
CRON_SECRET=your_custom_cron_secret_random_string

# Secret token to protect admin action endpoints (/api/admin/*)
ADMIN_SECRET=your_custom_admin_secret_random_string

# -----------------------------------------------------------------------------
# Initial Dailymotion Account Seed (Optional)
# -----------------------------------------------------------------------------
# Additional swarm accounts can also be added directly via Dashboard UI or seed script
DAILYMOTION_API_KEY=your_dm_partner_api_key
DAILYMOTION_API_SECRET=your_dm_partner_api_secret
DAILYMOTION_PROFILE_ID=your_dm_channel_profile_id

# -----------------------------------------------------------------------------
# Playmate Video Hosting Fallback Configuration
# -----------------------------------------------------------------------------
PLAYMATE_API_KEY=your_playmate_api_key
PLAYMATE_FOLDER_ID=1233
PLAYMATE_FOLDER_NAME=mult-audio

